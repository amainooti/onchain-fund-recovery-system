# Etherscan API Key
ETHERSCAN_API_KEY=your_etherscan_api_key

# Primary RPC (Infura)
INFURA_RPC_URL=https://mainnet.infura.io/v3/your_project_id

# Fallback RPCs
ANKR_RPC_URL=https://rpc.ankr.com/eth/your_ankr_key
# API Server
PORT=your_port
HOST=
NODE_ENV=
CORS_ORIGIN=

# Redis (for job queue)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# Environment or Production
NODE_ENV=development